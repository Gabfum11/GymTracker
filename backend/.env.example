# Copia questo file in .env e completa i valori. Il file .env non va mai su Git.
APP_DEBUG=true

# PostgreSQL locale (docker compose up -d)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gymtracker
DB_USER=gym
DB_PASSWORD=gym


# AI (https://console.groq.com/keys). Senza chiave la rotta /parse non esiste.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# chi può chiamare l API dal browser (* = tutti, va bene in locale)
CORS_ORIGIN=*

# firma dei JWT: almeno 32 caratteri casuali, diversa per ogni ambiente
# (generala con: php -r "echo bin2hex(random_bytes(32));")
JWT_SECRET=

# email (https://app.brevo.com → SMTP & API). Senza chiave il codice compare nel terminale del server.
BREVO_API_KEY=
MAIL_FROM=

# su Render: true (l'IP vero arriva nell'header X-Forwarded-For)
TRUST_PROXY=false

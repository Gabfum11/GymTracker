# Copia questo file in .env e completa i valori. Il file .env non va mai su Git.
APP_DEBUG=true

# PostgreSQL locale (docker compose up -d)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gymtracker
DB_USER=gym
DB_PASSWORD=gym

# utente fisso finché non c'è il login (php bin/migrate.php --dev-user)
DEV_USER_ID=1

# AI (https://console.groq.com/keys). Senza chiave la rotta /parse non esiste.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

{
    "name": "gymtracker/backend",
    "description": "API REST di GymTracker",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "firebase/php-jwt": "^7.2",
        "slim/psr7": "^1.8",
        "slim/slim": "^4",
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    }
}
